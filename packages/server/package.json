{
  "name": "@did-plc/server",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "description": "DID PLC Directory Service",
  "keywords": [
    "did-plc",
    "did",
    "atproto"
  ],
  "homepage": "https://web.plc.directory",
  "repository": {
    "type": "git",
    "url": "https://github.com/did-method-plc/did-method-plc",
    "directory": "packages/server"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node dist/bin.js",
    "test": "./pg/with-test-db.sh vitest run",
    "test:log": "cat test.log | pino-pretty",
    "build": "tsc --build tsconfig.build.json",
    "migration:create": "node ./bin/migration-create.ts"
  },
  "dependencies": {
    "@did-plc/lib": "workspace:*",
    "axios": "^1.3.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "http-terminator": "^3.2.0",
    "kysely": "^0.23.4",
    "multiformats": "^13.0.0",
    "pg": "^8.9.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.6.5",
    "@types/ws": "^8.18.1",
    "uint8arrays": "^5.0.0"
  }
}
