{
  "name": "@did-plc/server",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "description": "DID PLC Directory Service",
  "keywords": [
    "did-plc",
    "did",
    "atproto"
  ],
  "homepage": "https://web.plc.directory",
  "repository": {
    "type": "git",
    "url": "https://github.com/did-method-plc/did-method-plc",
    "directory": "packages/server"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --import=./dist/telemetry.js dist/bin.js",
    "test": "./pg/with-test-db.sh vitest run",
    "test:log": "cat test.log | pino-pretty",
    "build": "tsc --build tsconfig.build.json",
    "migration:create": "node ./bin/migration-create.ts"
  },
  "dependencies": {
    "@atproto/common": "0.8.1",
    "@atproto/crypto": "0.5.4",
    "@did-plc/lib": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-express": "^0.67.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-pg": "^0.72.0",
    "@opentelemetry/instrumentation-pino": "^0.65.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.32.0",
    "@opentelemetry/instrumentation-undici": "^0.29.0",
    "@opentelemetry/resource-detector-container": "^0.8.10",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "axios": "^1.3.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "http-terminator": "^3.2.0",
    "import-in-the-middle": "^3.0.1",
    "kysely": "^0.23.4",
    "multiformats": "^13.0.0",
    "pg": "^8.9.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.6.5",
    "@types/ws": "^8.18.1"
  }
}
