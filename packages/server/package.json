{
  "name": "@did-plc/server",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "description": "DID PLC Directory Service",
  "keywords": [
    "did-plc",
    "did",
    "atproto"
  ],
  "homepage": "https://web.plc.directory",
  "repository": {
    "type": "git",
    "url": "https://github.com/did-method-plc/did-method-plc",
    "directory": "packages/server"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --inspect=0.0.0.0:12582 src/bin.ts",
    "start": "node dist/bin.js",
    "test": "./pg/with-test-db.sh vitest run",
    "test:log": "cat test.log | pino-pretty",
    "prettier": "prettier --check src/",
    "prettier:fix": "prettier --write src/",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "verify": "run-p prettier lint",
    "verify:fix": "pnpm run prettier:fix && pnpm run lint:fix",
    "build": "tsc --build tsconfig.build.json",
    "migration:create": "ts-node ./bin/migration-create.ts",
    "did:create": "ts-node ./bin/did-create.ts"
  },
  "dependencies": {
    "@atproto/common": "0.8.1",
    "@atproto/crypto": "0.5.4",
    "@did-plc/lib": "workspace:*",
    "axios": "^1.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "http-terminator": "^3.2.0",
    "kysely": "^0.23.4",
    "multiformats": "^13.0.0",
    "pg": "^8.9.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.6.5",
    "@types/ws": "^8.18.1",
    "eslint-plugin-prettier": "^5.1.3"
  }
}
