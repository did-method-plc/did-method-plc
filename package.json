{
  "name": "did-method-plc",
  "type": "module",
  "version": "0.0.1",
  "repository": "git@github.com:did-method-plc/did-method-plc.git",
  "author": "Bluesky Social PBC <hello@blueskyweb.xyz>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev:ts": "tsc --build tsconfig.json --watch --force",
    "dev:server": "cd packages/server && node --enable-source-maps --watch --import=./dist/telemetry.js dist/bin.js",
    "dev": "pnpm run '/^dev:/'",
    "prepublish": "pnpm run '/^(build|lint|style)$/'",
    "style:fix": "prettier --experimental-cli --write .",
    "style": "prettier --experimental-cli --check .",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "verify": "pnpm run '/^(build|lint|style)$/'",
    "build": "tsc --build tsconfig.json",
    "test": "NODE_ENV=development pnpm run --recursive --stream test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@npmcli/package-json": "^3.0.0",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^16.0.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.15.0",
    "pino-pretty": "^9.1.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0"
}
